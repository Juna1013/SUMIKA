---
/**
 * ヒーローの桜。
 *
 * 絵はビルド時に描き上げてある（src/utils/sakura-art.ts）。墨のにじみは
 * 形に焼き込み済みで、ブラウザでは SVG フィルタを一切使わない。
 * 開幕の筆運びはマスクの線、花は一輪ずつの拡大、舞う花びらは
 * transform と opacity だけで動かすので、描き直しが小さく済む。
 */
import { petalPath } from '../data/sakura';
import {
  blossomInstances,
  blossomVariants,
  fallingPetals,
  inkBranches,
  inkHake,
  inkMoss,
} from '../utils/sakura-art';

/** 花びら五枚それぞれの不透明度（淡紅・濃紅・線描） */
const PETAL_OPACITY = [
  [0.95, 0.85, 0.9, 0.82, 0.88],
  [0.93, 0.84, 0.9, 0.8, 0.87],
  [1, 1, 1, 1, 1],
];
const KIND_CLASS = ['bloom-pale', 'bloom-deep', 'bloom-line'];
---
<!-- 共有の形（花・花びら・花の光） -->
<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <path id="fallPetal" d={petalPath} fill="currentColor" opacity=".88"/>

    <!-- 夜・朝・夕に花のまわりへ灯る光。花ごとにぼかしをかけると重いので、
         ぼかしではなく放射グラデーションの円を花の後ろに置く -->
    <radialGradient id="bloomGlow">
      <stop offset="0" class="glow-stop"/>
      <stop offset=".55" class="glow-stop"/>
      <stop offset=".7" class="glow-stop" stop-opacity=".5"/>
      <stop offset=".85" class="glow-stop" stop-opacity=".16"/>
      <stop offset="1" class="glow-stop" stop-opacity="0"/>
    </radialGradient>

    {blossomVariants.map((variant, v) => (
      <Fragment>
        {variant.petals.map((d, p) => <path id={`petal-${v}-${p}`} d={d}/>)}
        {KIND_CLASS.map((kindClass, kind) => (
          <g id={`bloom-${kind}-${v}`} class={kindClass}>
            <circle class="bloom-glow" r="21"/>
            <g class="bloom-petals">
              {variant.petals.map((_, p) => <use href={`#petal-${v}-${p}`} opacity={PETAL_OPACITY[kind][p]}/>)}
            </g>
            <circle class="bloom-heart" cx={variant.center[0]} cy={variant.center[1]} r={kind === 2 ? 1.3 : 1.7}/>
            {kind === 0 && (
              <g class="bloom-stamens">
                {variant.stamens.map(([x, y]) => <circle cx={x} cy={y} r=".6"/>)}
              </g>
            )}
          </g>
        ))}
      </Fragment>
    ))}
  </defs>
</svg>

<!-- 夜桜: 月と星（ダークテーマでのみ見える） -->
<div class="night-stars pointer-events-none z-0" aria-hidden="true"></div>
<div class="night-moon pointer-events-none z-0" aria-hidden="true"></div>

<!-- 刷毛（昼と朝のみ） -->
<svg class="hake-layer pointer-events-none absolute top-0 left-0 z-0 h-auto w-full" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
  <defs>
    <mask id="hakeReveal" maskUnits="userSpaceOnUse" x="-300" y="0" width="1800" height="620">
      <path class="hake-brush" pathLength="1" stroke-width={inkHake.revealWidth} d={inkHake.d}/>
    </mask>
  </defs>
  <path class="hake" d={inkHake.fill} mask="url(#hakeReveal)"/>
</svg>

<svg class="pointer-events-none absolute top-[clamp(50px,7vh,84px)] left-0 z-1 h-auto w-full max-mobile:left-[-78%] max-mobile:w-[178%]" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
  <defs>
    <!-- 筆運び: 枝の芯をなぞる白い線を伸ばし、焼き込んだ枝を順に見せる -->
    <mask id="inkReveal" maskUnits="userSpaceOnUse" x="-60" y="0" width="1320" height="400">
      {inkBranches.map((b) => <path class="stk" pathLength="1" style={`--dl:${b.delay}s`} stroke-width={b.revealWidth} d={b.d}/>)}
    </mask>
  </defs>
  <g mask="url(#inkReveal)">
    {inkBranches.map((b) => <path class={`ink-${b.tone}`} d={b.fill}/>)}
  </g>
  <!-- 苔点 -->
  <g class="mdot">
    {inkMoss.map((m) => <ellipse cx={m.cx} cy={m.cy} rx={m.rx} ry={m.ry} transform={`rotate(${m.angle} ${m.cx} ${m.cy})`}/>)}
  </g>
  <g class="bloom-layer">
    {blossomInstances.map((b) => (
      <g transform={`translate(${b.x} ${b.y}) rotate(${b.rotate}) scale(${b.scale})`}>
        <use href={`#bloom-${b.kind}-${b.variant}`} class="bloom-unit" style={`--bd:${b.delay}s`}/>
      </g>
    ))}
  </g>
</svg>

<!-- 舞う花びら。色は --fall-1〜5 でテーマに合わせて変わる -->
<div class="petal-layer pointer-events-none absolute inset-0 z-3 overflow-hidden" aria-hidden="true">
  {fallingPetals.map((p) => (
    <span class="petal-fall" style={`--x0:${p.x}vw;--drift:${p.drift}vw;--dur:${p.duration}s;--delay:${p.delay}s`}>
      <span class="petal" style={`width:${p.size}px;--sway:${p.sway}s;color:var(--fall-${p.tone})`}>
        <svg viewBox="-6.5 -8 13 16"><use href="#fallPetal"/></svg>
      </span>
    </span>
  ))}
</div>
