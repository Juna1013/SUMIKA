---
/**
 * ヒーローの桜。
 *
 * 絵はビルド時に描き上げてある（src/utils/sakura-art.ts）。墨のにじみは
 * 形に焼き込み済みで、ブラウザでは SVG フィルタを一切使わない。
 * 開幕の筆運びはマスクの線、花は一輪ずつの拡大、枝のそよぎと舞う花びらは
 * transform と opacity だけで動かすので、描き直しが小さく済む。
 * 花の型そのものは SakuraDefs にある。
 */
import PetalFall from './PetalFall.astro';
import { heroBloom, inkBranches, inkMoss } from '../utils/sakura-art';
---
<!-- 夜桜: 月と星（ダークテーマでのみ見える） -->
<div class="night-stars pointer-events-none z-0" aria-hidden="true"></div>
<div class="night-moon pointer-events-none z-0" aria-hidden="true"></div>

<!-- 春霞。枝と同じ枠に重ねて、枝の後ろへたなびかせる -->
<div class="hero-art hero-mist z-0" aria-hidden="true"></div>

<!-- 枝。風を受けて、幹の根もとを支点にごくわずかに揺れる -->
<svg class="hero-art bough z-1" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
  <defs>
    <!-- 筆運び: 枝の芯をなぞる白い線を伸ばし、焼き込んだ枝を順に見せる -->
    <mask id="inkReveal" maskUnits="userSpaceOnUse" x="-60" y="0" width="1320" height="400">
      {inkBranches.map((b) => <path class="stk" pathLength="1" style={`--dl:${b.delay}s`} stroke-width={b.revealWidth} d={b.d}/>)}
    </mask>
  </defs>
  <g mask="url(#inkReveal)">
    {inkBranches.map((b) => <path class={`ink-${b.tone}`} d={b.fill}/>)}
    <!-- 樹皮: 上の縁の光と、横縞 -->
    {inkBranches.map((b) => b.bark.light && <path class="bark-light" stroke-width={b.bark.lightWidth} d={b.bark.light}/>)}
    {inkBranches.map((b) => b.bark.marks && <path class="bark-mark" d={b.bark.marks}/>)}
  </g>
  <!-- 苔点 -->
  <g class="mdot">
    {inkMoss.map((m) => <ellipse cx={m.cx} cy={m.cy} rx={m.rx} ry={m.ry} transform={`rotate(${m.angle} ${m.cx} ${m.cy})`}/>)}
  </g>
  <!-- 花柄 -->
  <path class="stalk" style="--dl:1.5s" d={heroBloom.stalks}/>
  <g>
    {heroBloom.flowers.map((fl) => (
      <g transform={fl.transform}>
        <use href={fl.href} class="bloom-unit" style={`--bd:${fl.delay}s`}/>
      </g>
    ))}
  </g>
</svg>

<!-- 舞う花びら。色は --fall-1〜5 でテーマに合わせて変わる -->
<PetalFall mode="hero" />
