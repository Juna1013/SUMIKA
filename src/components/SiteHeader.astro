---
interface Props {
  isHome?: boolean;
  immediate?: boolean;
}

const { isHome = false, immediate = false } = Astro.props;
const links = isHome
  ? { home: '#/', works: '#/works', experience: '#/experience', output: '#/output' }
  : { home: '/', works: '/#/works', experience: '/#/experience', output: '/#/output' };

const navItems = [
  { label: 'About me', route: 'home' },
  { label: 'Works', route: 'works' },
  { label: 'Experience', route: 'experience' },
  { label: 'Output', route: 'output' },
] as const;
---

<nav class:list={[
  'site-nav fixed inset-x-0 top-0 z-40 flex items-center justify-between bg-[image:var(--nav-veil)] px-[4.5vw] py-[18px]',
  { immediate },
]}>
  <a class="relative z-2 flex items-baseline gap-3 text-ink no-underline" href={links.home} data-route={isHome ? 'home' : undefined}>
    <span class="text-2xl leading-none font-semibold">栖</span><span class="font-latin text-[11.5px] tracking-[.42em] text-ink-faint">SUMIKA</span>
  </a>

  <!-- デスクトップ: 横並び / モバイル: 墨色パネルの中に縦並び -->
  <ul class="nav-list m-0 flex list-none gap-[2em] p-0 mobile:ml-auto max-mobile:pointer-events-none max-mobile:fixed max-mobile:inset-0 max-mobile:z-1 max-mobile:flex-col max-mobile:items-center max-mobile:justify-center max-mobile:gap-[2.2em] max-mobile:opacity-0" id="navList">
    {navItems.map((item) => (
      <li class="nav-item max-mobile:opacity-0">
        <a
          class="nav-link pb-[3px] font-latin text-[13.5px] font-medium tracking-[.2em] whitespace-nowrap text-ink-soft no-underline transition-colors duration-350 hover:text-vermilion max-mobile:text-[18px] max-mobile:tracking-[.3em]"
          href={links[item.route]}
          data-route={isHome ? item.route : undefined}
        >{item.label}</a>
      </li>
    ))}
  </ul>

  <!-- テーマ切替（昼 ⇄ 夜桜） -->
  <button
    class="theme-toggle relative z-2 ml-auto flex h-11 w-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-ink-soft transition-colors duration-350 hover:text-vermilion max-mobile:mr-1"
    id="themeToggle"
    type="button"
    aria-label="ダークテーマに切り替える"
  >
    <!-- 昼は月（夜へ切り替える）、夜は日（昼へ切り替える） -->
    <svg class="theme-icon theme-icon-moon h-[19px] w-[19px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.3 2.1a.8.8 0 0 0-.9 1.05 7.6 7.6 0 0 0 9.45 9.45.8.8 0 0 1 .95 1.05A9.6 9.6 0 1 1 12.3 2.1Z"/>
    </svg>
    <svg class="theme-icon theme-icon-sun h-[19px] w-[19px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"/>
      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/>
      </g>
    </svg>
  </button>

  <!-- ハンバーガー（モバイルのみ） -->
  <button
    class="nav-toggle relative z-2 hidden h-11 w-11 cursor-pointer items-center justify-center border-0 bg-transparent p-0 max-mobile:flex"
    id="navToggle"
    type="button"
    aria-controls="navList"
    aria-expanded="false"
    aria-label="メニューを開く"
  >
    <span class="nav-toggle-bars relative block h-[13px] w-[23px]" aria-hidden="true">
      <span class="nav-bar top-0"></span>
      <span class="nav-bar top-[5.5px]"></span>
      <span class="nav-bar top-[11px]"></span>
    </span>
  </button>
</nav>

<script is:inline>
  /* テーマ切替。初期値は localStorage → OS設定の順で決める */
  (function(){
    var toggle = document.getElementById('themeToggle');
    if (!toggle) return;
    var root = document.documentElement;

    function label(theme){
      return theme === 'dark' ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える';
    }
    /* 描画前スクリプトが決めたテーマに合わせてラベルを初期化する */
    toggle.setAttribute('aria-label', label(root.dataset.theme));
    function apply(theme){
      root.dataset.theme = theme;
      toggle.setAttribute('aria-label', label(theme));
      try { localStorage.setItem('theme', theme); } catch (e) {}
      /* 花びらの色など、JS側で色を持つ描画に知らせる */
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } }));
    }

    toggle.addEventListener('click', function(){
      apply(root.dataset.theme === 'dark' ? 'light' : 'dark');
    });

    /* 手動で選ぶまでは OS 設定に追従する */
    var media = window.matchMedia('(prefers-color-scheme: dark)');
    function follow(e){
      var saved = null;
      try { saved = localStorage.getItem('theme'); } catch (err) {}
      if (!saved) apply(e.matches ? 'dark' : 'light');
    }
    if (media.addEventListener) media.addEventListener('change', follow);
    else media.addListener(follow);
  })();

  (function(){
    var toggle = document.getElementById('navToggle');
    var list = document.getElementById('navList');
    if (!toggle || !list) return;

    var mobile = window.matchMedia('(max-width: 47.5rem)');
    var open = false;

    function setOpen(next){
      open = next;
      document.body.classList.toggle('nav-open', next);
      toggle.setAttribute('aria-expanded', next ? 'true' : 'false');
      toggle.setAttribute('aria-label', next ? 'メニューを閉じる' : 'メニューを開く');
    }

    toggle.addEventListener('click', function(){ setOpen(!open); });

    /* リンクを押したらメニューを畳む（ハッシュ遷移では hashchange が出ないこともある） */
    list.addEventListener('click', function(e){
      if (e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && open) { setOpen(false); toggle.focus(); }
    });

    /* デスクトップ幅に戻したら状態をリセット */
    function onChange(){ if (!mobile.matches && open) setOpen(false); }
    if (mobile.addEventListener) mobile.addEventListener('change', onChange);
    else mobile.addListener(onChange);
  })();
</script>
