---
import '../styles/global.css';
import HeroArtwork from '../components/HeroArtwork.astro';
import MarkedText from '../components/MarkedText.astro';
import PetalFall from '../components/PetalFall.astro';
import SakuraDefs from '../components/SakuraDefs.astro';
import SeoHead from '../components/SeoHead.astro';
import SectionShell from '../components/SectionShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { about, acknowledgment, copyright, hero, seo, socialLinks } from '../data/about';
import { experience } from '../data/experience';
import { output } from '../data/output';
import { works } from '../data/works';
import { formatPostDate, monthOf, toDaiji, toWareki } from '../utils/date';
import { fetchLatestPosts } from '../utils/feeds';
import { wagaraCss, type WagaraName } from '../utils/wagara';

const posts = await fetchLatestPosts();

/* 制作物の札の帯。和柄と色を順に当てる（藍・抹茶・臙脂・山吹） */
const OBI: { pattern: WagaraName; color: string }[] = [
  { pattern: 'seigaiha', color: '#3f6184' },
  { pattern: 'asanoha', color: '#6c7a45' },
  { pattern: 'shippo', color: '#96475a' },
  { pattern: 'kikko', color: '#b28a3c' },
];

/* 年表を年ごとにまとめる（並びは data/experience.ts のまま） */
type Entry = (typeof experience.entries)[number];
const eras: { year: string; wareki: string; entries: Entry[] }[] = [];
for (const entry of experience.entries) {
  const year = entry.year.split('.')[0];
  const last = eras[eras.length - 1];
  if (last?.year === year) last.entries.push(entry);
  else eras.push({ year, wareki: toWareki(entry.year), entries: [entry] });
}
---
<!DOCTYPE html>
<html lang="ja" id="top">
<head>
<SeoHead title={seo.title} description={seo.description} />
<style is:inline set:html={wagaraCss}></style>
<script is:inline>
  /* 描画前にテーマを確定させ、リロード時に色がちらつくのを防ぐ */
  (function(){
    /* 選んだ配色を優先し、無ければOSの設定。判定できなければ夜桜 */
    var THEMES = ['light', 'dawn', 'dusk', 'dark'];
    var theme = 'dark';
    try {
      var saved = localStorage.getItem('theme');
      if (THEMES.indexOf(saved) !== -1) theme = saved;
      else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
    } catch (e) {}
    document.documentElement.dataset.theme = theme;
    /* ブラウザの上下のバーの色もテーマの地の色に合わせる（昼の色のままだと夜に白い帯が出る） */
    var PAPER = { light: '#f0e8d5', dawn: '#f2e4dc', dusk: '#f0dcd0', dark: '#14161f' };
    function syncThemeColor(){
      var meta = document.querySelector('meta[name="theme-color"]');
      var color = PAPER[document.documentElement.dataset.theme];
      if (meta && color) meta.setAttribute('content', color);
    }
    syncThemeColor();
    new MutationObserver(syncThemeColor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    /* 表示するページも描画前に確定させる（JSの読み込み前にフッターだけが見えるのを防ぐ） */
    var route = location.hash.replace(/^#\/?/, '');
    document.documentElement.dataset.route = ['works', 'experience', 'output'].indexOf(route) > -1 ? route : 'home';
    /* 初回描画では色の遷移を効かせない */
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){ document.documentElement.classList.add('theme-ready'); });
    });
  })();
</script>
</head>
<body>

<div class="grain pointer-events-none fixed inset-0 z-60 opacity-50 mix-blend-multiply" aria-hidden="true"></div>
<div class="wipe pointer-events-none fixed -inset-[6%_10%] z-55 translate-x-[-118%] -skew-x-8 bg-[image:var(--wipe)]" id="wipe" aria-hidden="true"></div>
<svg class="pointer-events-none fixed inset-0 z-50" id="rippleLayer" aria-hidden="true"></svg>

<SiteHeader isHome />
<SakuraDefs />

<!-- ============ HOME ============ -->
<div class="view" data-route="home">
  <!-- 絵（枝）の大きさは画面の幅で決まるので、文字の位置もそこから割り出す。
       高さの足りない画面ではヒーローが伸び、文字が絵に重ならない（global.css の #hero）。 -->
  <header class="hero" id="hero">
    <HeroArtwork />

    <div class="hero-title">
      <h1 class="hero-name">{hero.name}</h1>
      <p class="hero-sub">{hero.sub}</p>
    </div>

    <p class="hero-lead">
      {hero.leadLines.map((line, index) => (
        <>
          {index > 0 && <br />}
          <MarkedText text={line} />
        </>
      ))}
      <span class="mt-[1.2em] block font-latin text-[10.5px] font-medium tracking-[.36em] text-ink-faint">{hero.tagline}</span>
    </p>

    <a class="scroll-hint absolute bottom-6 left-1/2 z-4 flex -translate-x-1/2 flex-col items-center gap-2.5 text-[11px] tracking-[.5em] text-ink-soft no-underline [writing-mode:vertical-rl]" href="#about">{hero.scrollHint}<span class="scroll-line h-11 w-px origin-top bg-linear-to-b from-ink-soft to-transparent"></span></a>
  </header>
  <SectionShell id="about" ghost="私" eyebrow={about.eyebrow} title={about.title}>
    {about.introduction.map((paragraph) => <p class="my-[1em] text-[15px] leading-[2.35] tracking-[.1em] text-[var(--ink-body)]"><MarkedText text={paragraph} /></p>)}

    <div class="mt-[3.2em]">
      {about.skills.map((group) => (
        <div class="mt-[2.4em] first:mt-0">
          <h3 class="m-0 mb-[1.2em] font-latin text-xs font-semibold tracking-[.32em] text-ink-soft">{group.title}</h3>
          <!-- 道具は家紋のように丸で囲んで並べる -->
          <ul class="kamon-list">
            {group.items.map((item) => (
              <li class="kamon-item">
                <span class="kamon">
                  {'icon' in item ? (
                    <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon.path} /></svg>
                  ) : (
                    /* 画像ロゴは透明度をマスクにして、SVGアイコンと同じ色で塗る */
                    <span class="logo-mask h-7 w-7" style={`--logo-src: url(${item.image})`} aria-hidden="true" />
                  )}
                </span>
                <span class="kamon-label">{item.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </SectionShell>
</div>

<!-- ============ WORKS ============ -->
<div class="view" data-route="works">
  <PetalFall mode="stray" />
  <SectionShell id="works" ghost="作" ghostSide="left" eyebrow={works.eyebrow} title={works.title} sprig="works">
    <!-- 一枚ずつ、和柄の帯を締めた札にする。番付は大字、右肩の朱は落款 -->
    <div class="work-list">
      {works.items.map((item, index) => {
        const obi = OBI[index % OBI.length];
        return (
          <article class="work-card group" style={`--obi:${obi.color}`}>
            <div class="work-obi" aria-hidden="true">
              <span class="wagara" style={`--pattern:var(--wagara-${obi.pattern});--pattern-size:var(--wagara-${obi.pattern}-size)`}></span>
              <span class="work-no">其ノ{toDaiji(index + 1)}</span>
            </div>
            <div class="work-body">
              <span class="seal" aria-hidden="true">{item.character}</span>
              <h3 class="work-title">{item.title}</h3>
              <p class="m-0 flex-1 text-[13px] leading-8 tracking-[.08em] text-ink-soft">{item.description}</p>
              <div class="flex flex-wrap gap-2">{item.tags.map((tag) => <span class="rounded-xs border border-line px-[.8em] py-[.35em] font-latin text-[10.5px] tracking-[.22em] text-ink-faint">{tag}</span>)}</div>
              <div class="flex flex-wrap gap-x-[1.6em] gap-y-2 font-latin text-[11.5px] font-semibold tracking-[.26em] text-vermilion">
                {item.links.map((link) => <a class="no-underline underline-offset-4 hover:underline" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </SectionShell>
</div>

<!-- ============ EXPERIENCE ============ -->
<div class="view" data-route="experience">
  <PetalFall mode="stray" />
  <SectionShell id="experience" ghost="歴" ghostSide="right" eyebrow={experience.eyebrow} title={experience.title} sprig="experience">
    <!-- 年ごとに区切り、西暦に和暦を添える。月には和風月名を添える -->
    <div class="era-list">
      {eras.map((era) => (
        <section class="era">
          <header class="era-head">
            <span class="era-year">{era.year}</span>
            <span class="era-wareki">{era.wareki}</span>
          </header>
          <ul class="footprint">
            {era.entries.map((entry) => {
              const month = monthOf(entry.year);
              return (
                <li class:list={['fp-item', { 'has-award': entry.awards.length > 0 }]}>
                  <span class="fp-date">
                    {month ? <>{month.latin}<span class="fp-month-ja">{month.ja}</span></> : entry.year}
                  </span>
                  <span class="fp-text">{entry.text}{entry.detail && <span class="ml-[.8em] inline-block font-latin text-[12.5px] whitespace-nowrap tracking-[.16em] text-ink-faint">{entry.detail}</span>}</span>
                  {entry.description && <span class="mt-[.25em] block text-[12.5px] leading-7 tracking-[.08em] text-ink-faint">{entry.description}</span>}
                  {entry.awards.length > 0 && (
                    <span class="mt-[.7em] flex flex-wrap gap-2">
                      {entry.awards.map((award) => <span class="award">{award}</span>)}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </SectionShell>
</div>

<!-- ============ OUTPUT ============ -->
<div class="view" data-route="output">
  <PetalFall mode="stray" />
  <SectionShell id="output" ghost="記" eyebrow={output.eyebrow} title={output.title} sprig="output">
    <!-- 記事は和綴じの冊子に見立てる。左の縁が糸でかがった背 -->
    <ul class="m-0 mt-[2.8em] grid list-none grid-cols-[repeat(auto-fill,minmax(min(270px,100%),1fr))] gap-[26px] p-0" id="postList">
      {posts.map((post, index) => (
        <li class:list={['post-item', { 'is-extra': index >= output.initialCount }]}>
          <a class="book group" href={post.url} target="_blank" rel="noopener noreferrer">
            <span class="book-spine" aria-hidden="true"></span>
            <span class="book-body">
              <span class="relative block aspect-[1200/630] overflow-hidden rounded-xs border border-line bg-[color-mix(in_srgb,var(--color-ink)_5%,transparent)]">
                {post.ogImage ? (
                  <img
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    src={post.ogImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="flex h-full w-full items-center justify-center text-[34px] font-semibold text-ink opacity-10" aria-hidden="true">記</span>
                )}
              </span>
              <span class="flex items-center gap-[1em]">
                <span class="seal seal-sm font-latin" aria-hidden="true">{post.source}</span>
                <span class="font-latin text-xs tracking-[.2em] text-ink-faint">{formatPostDate(post.pubDate)}</span>
              </span>
              <span class="book-title">{post.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    {posts.length > output.initialCount && (
      <div class="mt-[2.8em] flex justify-center">
        <button
          class="nav-more cursor-pointer rounded-xs border border-line bg-transparent px-[2em] py-[.85em] font-latin text-[11.5px] font-semibold tracking-[.26em] text-ink-soft transition-colors duration-350 hover:border-[color-mix(in_srgb,var(--color-vermilion)_55%,transparent)] hover:text-vermilion"
          id="postMore"
          type="button"
          aria-controls="postList"
          aria-expanded="false"
        >{output.moreLabel.replace('{count}', String(posts.length - output.initialCount))}</button>
      </div>
    )}

    <p class="mt-[2.6em] mb-[1.4em] text-[12.5px] tracking-[.14em] text-ink-faint">{output.note}</p>
    <div class="flex flex-wrap gap-[1.6em] font-latin text-[11.5px] font-semibold tracking-[.26em] text-vermilion">
      {output.profiles.map((profile) => <a class="no-underline underline-offset-4 hover:underline" href={profile.href} target="_blank" rel="noopener noreferrer">{profile.label}</a>)}
    </div>
  </SectionShell>
</div>

<script is:inline>
  (function(){
    var more = document.getElementById('postMore');
    var list = document.getElementById('postList');
    if (!more || !list) return;
    more.addEventListener('click', function(){
      list.classList.add('show-all');
      more.remove();
    });
  })();
</script>

<!-- ============ footer ============ -->
<footer class="site-footer">
  <!-- 足もとに青海波を敷く -->
  <div class="foot-waves" aria-hidden="true"><span class="wagara" style="--pattern:var(--wagara-seigaiha);--pattern-size:var(--wagara-seigaiha-size)"></span></div>
  <!-- 桜の飾り罫 -->
  <div class="flex w-full items-center justify-center gap-5" aria-hidden="true">
    <span class="h-px w-[min(180px,24vw)] bg-[linear-gradient(to_left,var(--color-line),transparent)]"></span>
    <svg class="h-[26px] w-[26px] -rotate-6 overflow-visible" viewBox="-15 -15 30 30"><use href="#bl-f0-0"/></svg>
    <span class="h-px w-[min(180px,24vw)] bg-[linear-gradient(to_right,var(--color-line),transparent)]"></span>
  </div>
  <div class="flex flex-wrap items-center justify-center gap-[1.4em]">
    {socialLinks.map((link) => (
      <a
        class="flex h-[54px] w-[54px] items-center justify-center text-ink-soft no-underline transition-colors duration-350 hover:text-vermilion"
        href={link.href}
        aria-label={link.label}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <svg class="h-[33px] w-[33px] fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={link.icon.path} /></svg>
      </a>
    ))}
  </div>
  <p class="m-0 text-[11.5px] leading-7 tracking-[.14em] text-ink-faint">
    {acknowledgment.prefix}<a class="text-ink-soft underline underline-offset-4 transition-colors duration-350 hover:text-vermilion" href={acknowledgment.href} target="_blank" rel="noopener noreferrer">{acknowledgment.linkText}</a>{acknowledgment.suffix}
  </p>
  <span class="font-latin text-[11px] tracking-[.3em] text-ink-faint">{copyright}</span>
</footer>

<script src="../scripts/main.js"></script>
</body>
</html>
